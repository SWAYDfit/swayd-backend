# Copy to .env for local development. On Railway, set these under Variables.

# Railway Postgres provides this automatically when you add the database
DATABASE_URL=postgres://user:password@localhost:5432/swayd

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# The email you sign up with becomes the owner account (you)
OWNER_EMAIL=you@example.com

# Where the frontend lives, comma-separated (exact origins, no trailing slash)
CORS_ORIGINS=http://localhost:5173,https://swayd.vercel.app

# Timezone used for "today" and weekly resets
APP_TZ=Australia/Melbourne

# AI coach (from console.anthropic.com). Leave blank to switch the coach off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Photo storage. "disk" uses a Railway volume mounted at UPLOAD_DIR.
STORAGE=disk
UPLOAD_DIR=/data/uploads
# Only if STORAGE=s3 (e.g. Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Marks the staging environment (shows the sandbox banner in the app)
SANDBOX=false
PORT=3000
